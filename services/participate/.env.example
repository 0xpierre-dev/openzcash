DATABASE_URL=postgresql://app:app@localhost:5432/community_shielded_voting?schema=public
ZCAP_SESSION_SECRET=replace-with-a-long-random-secret
ZCAP_INTERNAL_SECRET=replace-with-a-long-random-secret
ZCASH_NETWORK=testnet
ZALLET_RPC_URL=http://127.0.0.1:28232/
ZALLET_FROM_ADDRESS=
ZALLET_RPC_USER=
ZALLET_RPC_PASSWORD=
POLL_COLLECTOR_ACCOUNT_UUID=
# Read-only history verification; these do not enable vote finalization.
POLL_COLLECTOR_NETWORK=
POLL_CHAIN_RPC_URL=
POLL_CHAIN_RPC_USER=
POLL_CHAIN_RPC_PASSWORD=
SIGNAL_API_URL=
SIGNAL_SENDER=
# Optional bearer token if the private Signal REST API is behind an internal gateway.
SIGNAL_API_TOKEN=
RESEND_API_KEY=
# Set your own verified sender, for example Your App <support@example.org>.
# Scope the sending key to your verified domain.
RESEND_FROM_EMAIL=
APP_BASE_URL=http://localhost:3000
# When served inside OpenZcash, use https://openzcash.org here and as
# PARTICIPATE_PARENT_ORIGIN. The backend itself can stay on private networking.
# Optional Demo API key, kept server-side. Keyless requests depend on provider availability.
# Used only for indicative ZEC/USD funding estimates; never enables payments.
COINGECKO_DEMO_API_KEY=
# Optional override for passkeys; production falls back to APP_BASE_URL.
# Must be the exact public HTTPS origin. Local development uses localhost.
# PASSKEY_ORIGIN=http://localhost:3000

# Required only for npm run db:seed. Set the password explicitly before seeding.
# The seed creates an active owner for a new community; it does not assign legacy rows.
SEED_ADMIN_NICK=operations-admin
SEED_ADMIN_PASSWORD=
SEED_COMMUNITY_NAME=Example Community
SEED_COMMUNITY_SLUG=example-community
# Optional contact for a newly created seed user; existing users are not overwritten.
SEED_ADMIN_EMAIL=

# Incoming credit purchases are disabled until each DAO receiver is configured.
# Read docs/credit-purchases.md before activation. Never put spending keys here.
CREDIT_PAYMENTS_ENABLED=false
CREDIT_RECEIVERS_JSON=[]
# Explicit secret for the private payment reconciler; no development fallback.
CREDIT_RECONCILE_SECRET=

# Proposal archive observation. This never enables mainnet signing.
# Use a dedicated public archive account, never a personal or treasury viewing key.
ARCHIVE_NETWORK=
ARCHIVE_RECEIVER=
# Optional Sapling diversifier index, verified against the published key.
ARCHIVE_RECEIVER_INDEX=
ARCHIVE_PUBLIC_VIEWING_KEY=
ARCHIVE_BIRTHDAY_HEIGHT=
ARCHIVE_ZALLET_VERSION=0.1.0-beta.3
ARCHIVE_CONFIRMATIONS=10
# Independent view-only reader; wallet HTTP must use a loopback tunnel.
ARCHIVE_READER_RPC_URL=
ARCHIVE_READER_RPC_USER=
ARCHIVE_READER_RPC_PASSWORD=
ARCHIVE_CHAIN_RPC_URL=
ARCHIVE_CHAIN_RPC_USER=
ARCHIVE_CHAIN_RPC_PASSWORD=
# Optional testnet operator only. Keep absent from the public web process.
ARCHIVE_TESTNET_SIGNING_ENABLED=false
ARCHIVE_WRITER_RPC_URL=
ARCHIVE_WRITER_RPC_USER=
ARCHIVE_WRITER_RPC_PASSWORD=
# Participate entry served through OpenZcash. Set the host community explicitly.
PARTICIPATE_COMMUNITY_ID=
# Public free pilot: personal email accounts, 25 demo Zcred once per account.
# Requires the exact committee scope and HTTPS APP_BASE_URL in production.
# Real purchases, shared demo sign-in and live committee operations stay off.
PARTICIPATE_PUBLIC_DEMO=false
PARTICIPATE_DEMO_COMMITTEE_ID=
# Keep false until the committee explicitly authorizes live operations.
# Admin password access grants a read-only preview; it never enables voting.
PARTICIPATE_COMMITTEE_ENABLED=false
# Exact portal origin. HTTPS outside local development; no wildcard.
PARTICIPATE_PARENT_ORIGIN=
# Server-only prepared recipient: communityId, operator, network=mainnet,
# address and accountId. Verified receiving metadata only; this does not enable
# purchases. CREDIT_RECEIVERS_JSON must match it when payments are activated.
CREDIT_PILOT_RECEIVER_JSON=

# Email-first sign-in (optional until a verified sender is ready).
# Keep all values server-only. Use a separately generated secret with >=32 characters.
EMAIL_AUTH_SECRET=
# Set RESEND_API_KEY and RESEND_FROM_EMAIL above after verifying your sender.
# Production also requires a strong ZCAP_SESSION_SECRET and HTTPS APP_BASE_URL.
# Private worker only. Never set a writer endpoint in the public web application.
# PARTICIPATE_AUTOMATION_CONFIG=/etc/participate/automation.json
# PARTICIPATE_GITHUB_READ_TOKEN=

# Optional read-only release preflight: intended verified administrator.
PARTICIPATE_RELEASE_ADMIN_EMAIL=
