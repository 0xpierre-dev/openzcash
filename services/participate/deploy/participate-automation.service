[Unit]
Description=OpenZcash proposal discovery and Zcash anchoring
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=participate
WorkingDirectory=/opt/participate
EnvironmentFile=/etc/participate/worker.env
ExecStart=/usr/bin/node --import tsx scripts/participate-automation.ts run
TimeoutStartSec=1800
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/participate
StandardOutput=journal
StandardError=journal
