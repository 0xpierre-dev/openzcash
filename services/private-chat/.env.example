# Local preview: no account, database, directory service or API key is required.
NEXT_PUBLIC_PRIVATE_CHAT_PREVIEW=true
PRIVATE_CHAT_PARENT_ORIGIN=http://127.0.0.1:3000

# Production (set at BUILD and runtime; leave preview flags out):
# PRIVATE_CHAT_DEPLOYMENT=pilot
# NEXT_PUBLIC_PRIVATE_CHAT_PILOT=true
# PRIVATE_CHAT_ISOLATED=true
# PRIVATE_CHAT_ORIGIN=https://chat.example.org
# PRIVATE_CHAT_PARENT_ORIGIN=https://portal.example.org
# NEXT_PUBLIC_PRIVATE_CHAT_GATEWAY_ORIGIN=wss://your-gateway.example.org
# NEXT_PUBLIC_PRIVATE_CHAT_GATEWAY_ID=<matching-base58-gateway-identity>
